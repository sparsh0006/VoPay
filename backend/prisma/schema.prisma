generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  telegramUsername String   @unique
  telegramId       String   @unique
  walletAddress    String
  ensName          String?  // e.g. "deepak.eth"
  createdAt        DateTime @default(now())

  paidExpenses Expense[]     @relation("Payer")
  splits       Split[]
  groupMembers GroupMember[]
}

model Group {
  id         String   @id @default(cuid())
  telegramId String   @unique
  name       String
  createdAt  DateTime @default(now())

  members  GroupMember[]
  expenses Expense[]
}

model GroupMember {
  id      String @id @default(cuid())
  groupId String
  userId  String

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

model Expense {
  id          String        @id @default(cuid())
  description String
  total       Float
  groupId     String
  payerId     String
  status      ExpenseStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  settledAt   DateTime?

  group  Group   @relation(fields: [groupId], references: [id])
  payer  User    @relation("Payer", fields: [payerId], references: [id])
  splits Split[]
}

model Split {
  id        String      @id @default(cuid())
  expenseId String
  userId    String
  amount    Float
  txHash    String?
  status    SplitStatus @default(PENDING)

  expense Expense @relation(fields: [expenseId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

enum ExpenseStatus {
  PENDING
  SETTLED
  CANCELLED
}

enum SplitStatus {
  PENDING
  PAID
}